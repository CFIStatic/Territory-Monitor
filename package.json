{
  "name": "territory-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal market-intelligence map for restoration-industry franchise territories (SERVPRO, ServiceMaster Restore, and competitors).",
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:41729/git/CFIStatic/Territory-Monitor"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:data": "node scripts/build-zip-index.mjs && node scripts/build-territories.mjs",
    "build:zips": "node scripts/build-zip-index.mjs",
    "build:territories": "node scripts/build-territories.mjs",
    "data:census": "node scripts/fetch-census.mjs",
    "ingest": "node scripts/ingest-site.mjs"
  },
  "dependencies": {
    "@turf/turf": "^7.3.5",
    "leaflet": "^1.9.4",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
